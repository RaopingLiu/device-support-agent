MODEL_NAME=your-tool-calling-model
OPENAI_API_BASE=https://your-provider.example/v1
OPENAI_API_KEY=
# Optional read-only source for existing local credentials (never committed).
CREDENTIALS_FILE=
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=network_knowledge_v1
# Absolute paths on your own machine; the worker uses an existing local model.
EMBEDDING_PYTHON=C:/path/to/embedding-env/Scripts/python.exe
EMBEDDING_MODEL=C:/path/to/paraphrase-multilingual-MiniLM-L12-v2
